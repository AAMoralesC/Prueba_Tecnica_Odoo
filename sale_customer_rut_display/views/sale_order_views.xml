<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Formulario -->
    <record id="view_order_form_inherit_rut" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rut</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_vat"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de Lista (Cotizaciones) -->
    <record id="view_quotation_tree_inherit_rut" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.inherit.rut</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_vat" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de Lista (Pedidos de Venta) -->
    <record id="view_order_tree_inherit_rut" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.rut</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_vat" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="view_sales_order_filter_inherit_rut" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.rut</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_vat" string="RUT del Cliente" filter_domain="[('partner_vat', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
